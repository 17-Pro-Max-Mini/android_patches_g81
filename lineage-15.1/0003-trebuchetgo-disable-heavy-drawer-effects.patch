From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: G81EM1 bring-up <g81em1@localhost>
Date: Wed, 16 Sep 2026 08:41:00 +0300
Subject: [PATCH] TrebuchetGo: fix build and disable heavy drawer effects

The MT6580/Mali-400 device spends most launcher jank in the all-apps gradient
and physics paths. Keep the Go launcher's existing widget and spring-icon
reductions and also disable those two expensive effects.

The Go target compiles the shared searchlauncher sources but omitted the
libGoogleFeed dependency that provides LauncherClient. Match the regular
Trebuchet target so the Go package links successfully.
---
 Android.mk                                                   | 3 ++-
 .../com/android/launcher3/config/FeatureFlags.java           | 2 ++
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/Android.mk b/Android.mk
index 3a6bdd721..18a203164 100644
--- a/Android.mk
+++ b/Android.mk
@@ -92,7 +92,8 @@ LOCAL_STATIC_JAVA_LIBRARIES := \
     android-support-v7-appcompat \
     android-support-v7-recyclerview \
     android-support-v7-palette \
-    android-support-dynamic-animation
+    android-support-dynamic-animation \
+    libGoogleFeed
 
 LOCAL_SRC_FILES := \
     $(call all-java-files-under, src) \
diff --git a/go/src_flags/com/android/launcher3/config/FeatureFlags.java b/go/src_flags/com/android/launcher3/config/FeatureFlags.java
index b11bb7c6a..92deec48b 100644
--- a/go/src_flags/com/android/launcher3/config/FeatureFlags.java
+++ b/go/src_flags/com/android/launcher3/config/FeatureFlags.java
@@ -25,5 +25,7 @@ public final class FeatureFlags extends BaseFlags {
 
     // Features to control Launcher3Go behavior
     public static final boolean GO_DISABLE_WIDGETS = true;
+    public static final boolean LAUNCHER3_GRADIENT_ALL_APPS = false;
+    public static final boolean LAUNCHER3_PHYSICS = false;
     public static final boolean LAUNCHER3_SPRING_ICONS = false;
 }

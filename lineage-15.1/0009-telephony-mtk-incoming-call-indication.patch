+    private synchronized void allowIncomingCall(String callIdString, String seqNoString) {
+        if (mRadioBinder == null) {
+            Rlog.w(TAG, "Cannot acknowledge incoming call without MTK radio connection");
+            return;
+        }
+
+        final int callId;
+        final int seqNo;
+        try {
+            callId = Integer.parseInt(callIdString);
+            seqNo = Integer.parseInt(seqNoString);
+        } catch (NumberFormatException e) {
+            Rlog.w(TAG, "Invalid MTK incoming call identifiers", e);
+            return;
+        }
+
+        int serial = mRil.obtainRequestSerial(RIL_REQUEST_SET_CALL_INDICATION, null,
+                mRil.mRILDefaultWorkSource);
+        HwParcel request = new HwParcel();
+        HwParcel reply = new HwParcel();
+        try {
+            request.writeInterfaceToken(RADIO_INTERFACE);
+            request.writeInt32(serial);
+            request.writeInt32(0); // 0 allows the incoming call; 1 rejects it.
+            request.writeInt32(callId);
+            request.writeInt32(seqNo);
+            mRadioBinder.transact(SET_CALL_INDICATION, request, reply, IHwBinder.FLAG_ONEWAY);
+            request.releaseTemporaryStorage();
+            Rlog.d(TAG, "Acknowledged MTK incoming call indication");
+        } catch (RemoteException | RuntimeException e) {
+            mRadioBinder = null;
+            completeFailedRequest(serial);
+            Rlog.e(TAG, "Failed to acknowledge MTK incoming call indication", e);
+        } finally {
+            reply.release();
+        }
+    }
+
+    private void completeFailedRequest(int serial) {

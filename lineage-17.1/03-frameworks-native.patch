+static bool convertQueueBufferInputDirect(
+        BGraphicBufferProducer::QueueBufferInput* l,
+        HGraphicBufferProducer::QueueBufferInput const& t) {
+    int fd = native_handle_read_fd(t.fence);
+    sp<Fence> fence = Fence::NO_FENCE;
+    if (fd >= 0) {
+        int dupFd = ::dup(fd);
